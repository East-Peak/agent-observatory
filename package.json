{
  "name": "agent-observatory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "knip": "knip",
    "verify": "npm run lint && npm run knip && npm run test:run",
    "ledger:init": "npm --workspace packages/ledger run init --",
    "ledger:backfill": "npm --workspace packages/ledger run backfill --",
    "ledger:ops:install": "npm --workspace packages/ledger run ops:install --",
    "ledger:ops:uninstall": "npm --workspace packages/ledger run ops:uninstall --",
    "ingest": "node scripts/ingest.mjs",
    "trust:sidecar": "node scripts/trust-sidecar.mjs",
    "data:generate": "tsx scripts/data-generate.ts",
    "verify:step": "node scripts/verify.mjs",
    "verify:demo-ready": "node scripts/verify.mjs --demo-ready",
    "verify:complete": "node scripts/verify.mjs --complete",
    "certify:complete": "node scripts/certify.mjs",
    "arch:graph": "npx --yes madge --ts-config tsconfig.json --extensions ts,tsx --json src/main.tsx | node tools/arch-graph.mjs",
    "verify:all": "npm run verify && npm --workspace packages/pricing run verify && npm --workspace packages/ledger run verify"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ccusage": "20.0.14",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.4.0",
    "vitest": "^4.1.9"
  }
}
